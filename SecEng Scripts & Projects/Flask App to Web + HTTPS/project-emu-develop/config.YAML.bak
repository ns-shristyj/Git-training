#Path to the sqlite3.exe executable on Windows, set this before running
WIN_SQLITE_PATH: C:\\Users\\Jose Ramirez\\Documents\\sqlite\\sqlite3.exe
#Path to the sqlite3 binary on Linux, set this before running
LINUX_SQLITE_PATH: ""
#Path to the sqlite package on MacOS, set this before running
MAC_SQLITE_PATH: ""
#Install/Home path, will be set automatically by main.py
EMU_INSTALL_PATH: ${EMU_INSTALL_PATH}
#Config file path
CONFIG_PATH: ${EMU_INSTALL_PATH}\\config.YAML
#SBOM Databse Path
DB_PATH: ${EMU_INSTALL_PATH}\\sbom.db
#SBOM file upload path
UPLOAD_PATH: ${EMU_INSTALL_PATH}\\uploads
#Cyclone-DX binary path(Mac)
CYDX_MAC_PATH: ${EMU_INSTALL_PATH}\\cyclonedx-osx-x64
#Cyclone-DX binary path(Linux)
CYDX_LIN_PATH: ${EMU_INSTALL_PATH}\\cyclonedx-linux-x64
#Cyclone-DX binary path(Windows)
CYDX_WIN_PATH: ${EMU_INSTALL_PATH}\\cyclonedx-win-x64.exe
#Allowed extensions
ALLOWED_EXT:
  - json
  - xml
  - yaml
  - yml
  - spdx
  - xlsx
  - csv